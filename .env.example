# Loopback only — start-server binds 127.0.0.1
PORT=3011
NODE_ENV=development

# Postgres (SERVER-ONLY — never expose in browser NEXT_PUBLIC_* vars)
# Same local database as my-health-open-source-express-server.
# Apply schema with: psql "$DATABASE_URL" -f migrations/setup.sql
# setup.sql is IF NOT EXISTS, so an already-migrated my_health database is safe to re-run.
# Example (Homebrew Postgres on Mac):
# DATABASE_URL=postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/my_health
DATABASE_URL=

# Optional connection pool cap (default 10)
# PG_POOL_MAX=10

# Anthropic vision for homework photo import (optional)
# Required only for POST /api/data/therapy-exercise-imports/preview
# SERVER-ONLY — never put this in NEXT_PUBLIC_*
ANTHROPIC_API_KEY=
