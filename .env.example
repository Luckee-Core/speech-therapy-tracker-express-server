# =============================================================================
# Speech Therapy Tracker Express API
# Copy to .env. Use the SAME Postgres database as My Health.
# =============================================================================

PORT=3011
NODE_ENV=development

# Postgres (SERVER-ONLY — never expose in browser NEXT_PUBLIC_* vars)
# Must match my-health-open-source-express-server DATABASE_URL (database my_health).
# Example (Homebrew Postgres on Mac):
# DATABASE_URL=postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/my_health
DATABASE_URL=

# Optional connection pool cap (default 10)
# PG_POOL_MAX=10

# Anthropic vision for homework photo import (required for POST /preview)
# Same key as My Health if you already had photo import working there.
ANTHROPIC_API_KEY=
